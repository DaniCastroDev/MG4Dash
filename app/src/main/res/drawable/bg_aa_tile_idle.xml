<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/button_pressed" /><corners android:radius="@dimen/radius_panel" /><stroke android:width="1dp" android:color="@color/accent_action" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/panel" /><corners android:radius="@dimen/radius_panel" /><stroke android:width="1px" android:color="@color/panel_border" /></shape>
    </item>
</selector>
