<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="?attr/mgButtonPressed" /><corners android:radius="@dimen/radius_panel" /><stroke android:width="1dp" android:color="?attr/mgAction" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="?attr/mgPanel" /><corners android:radius="@dimen/radius_panel" /><stroke android:width="1px" android:color="?attr/mgPanelBorder" /></shape>
    </item>
</selector>
