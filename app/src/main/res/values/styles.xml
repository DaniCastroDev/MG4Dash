<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MG4Launcher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_root</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">?attr/mgBgTop</item>
        <item name="android:navigationBarColor">?attr/mgBgTop</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="colorAccent">?attr/mgAction</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_value</item>
        <item name="mgBgTop">#FF0B0F17</item>
        <item name="mgBgBottom">#FF141B29</item>
        <item name="mgBgEnd">#FF0E1420</item>
        <item name="mgPanel">#D912161F</item>
        <item name="mgPanelBorder">#FF2A3142</item>
        <item name="mgButtonIdle">#FF1C2231</item>
        <item name="mgButtonPressed">#FF283048</item>
        <item name="mgGaugeOff">#FF262D3D</item>
        <item name="mgPill">#CC12161F</item>
        <item name="mgButtonDisabled">#801C2231</item>
        <item name="mgAction">#FF2979FF</item>
        <item name="mgSelect">#FF00D2FF</item>
        <item name="mgActionPressed">#FF1C54B2</item>
        <item name="mgActionDeep">#FF123672</item>
        <item name="mgActionDeeper">#FF0D2651</item>
        <item name="mgActionBorder">#FF4F91FF</item>
        <item name="mgActionTint">#262979FF</item>
        <item name="mgSelectTint">#2600D2FF</item>
    </style>

    <style name="CardTitle">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ValueBig">
        <item name="android:textColor">@color/text_value</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Sub">
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">18sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Panel">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">@dimen/panel_pad</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_value</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
