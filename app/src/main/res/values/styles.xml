<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MG4Launcher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_root</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_top</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="colorAccent">@color/accent_action</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_value</item>
    </style>

    <style name="CardTitle">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ValueBig">
        <item name="android:textColor">@color/text_value</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Sub">
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">18sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Panel">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">@dimen/panel_pad</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_value</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
